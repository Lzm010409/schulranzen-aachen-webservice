# ---------------------------------------------------------------- Pflicht
# Verbindung zur PostgreSQL-Datenbank
DATABASE_URL="postgresql://benutzer:passwort@host:5432/datenbank"

# Signiert Sitzungscookies und Abmeldelinks. Mindestens 32 Zeichen.
#   openssl rand -base64 32
SESSION_SECRET=""

# Verschluesselt die SMTP-Passwoerter in der Datenbank. Genau 32 Byte, base64.
#   openssl rand -base64 32
# ACHTUNG: Wird dieser Schluessel geaendert, sind hinterlegte SMTP-Passwoerter
# nicht mehr lesbar und muessen neu eingegeben werden.
ENCRYPTION_KEY=""

# Oeffentliche Adresse der Anwendung — steckt in jedem Abmeldelink.
APP_URL="https://schulranzen.example.de"

# ---------------------------------------------------------------- Optional
# Versandgeschwindigkeit. Provider drosseln typisch ab 100–500 Mails/Stunde.
MAIL_RATE_PER_MINUTE=20

# Versand-Worker abschalten (z. B. auf einer zweiten Instanz).
MAIL_WORKER_ENABLED=true

# Zustellversuche je Empfaenger, bevor ein Job endgueltig scheitert.
MAIL_MAX_ATTEMPTS=3

# Wie lange Eintraege im Anwendungsprotokoll stehen bleiben (Tage).
LOG_RETENTION_DAYS=90

# ------------------------------------------------- Erster Start (einmalig)
# Sind beide gesetzt, legt der Container beim Start den Administrator an.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ------------------------------------------------- Datenuebernahme (einmalig)
# Nur fuer den direkten Import aus der alten Datenbank noetig.
LEGACY_DATABASE_URL=""
LEGACY_SCHEMA="public"
